[
  {
    "stage": "dependencies",
    "exit": 0,
    "arguments": [
      "list",
      "-mod=readonly",
      "-deps",
      "-test",
      "-f",
      "{{.ImportPath}}\t{{.Dir}}\t{{join .GoFiles \"|\"}}\t{{join .CgoFiles \"|\"}}\t{{join .EmbedFiles \"|\"}}",
      "./internal/systembackupresources"
    ]
  },
  {
    "stage": "counterfactual",
    "exit": 1,
    "arguments": [
      "test",
      "-mod=readonly",
      "-p=1",
      "-count=1",
      "-timeout=900s",
      "-run",
      "^TestResourcesCaptureProof(CannotChangeValidatedInputs|InputsStaySeparate|CannotHideOriginalMismatches|EmptyAuditPreservesNull)$",
      "-json",
      "./internal/systembackupresources"
    ]
  },
  {
    "stage": "isolated",
    "exit": 0,
    "arguments": [
      "test",
      "-mod=readonly",
      "-p=1",
      "-count=1",
      "-timeout=900s",
      "-json",
      "./internal/systembackupresources"
    ]
  },
  {
    "stage": "published",
    "exit": 0,
    "arguments": [
      "test",
      "-mod=readonly",
      "-p=1",
      "-count=1",
      "-timeout=900s",
      "-json",
      "./internal/systembackupresources"
    ]
  }
]
