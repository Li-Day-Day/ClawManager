    "queries": [
      {
        "id": "observer_identity",
        "parameters": [],
        "sql": "SELECT @@server_uuid,DATABASE(),CURRENT_USER(),CURRENT_ROLE(),UTC_TIMESTAMP(6),@@version,@@version_comment"
      },
      {
        "id": "observer_grants",
        "parameters": [],
        "sql": "SHOW GRANTS"
      },
      {
        "id": "trigger_definitions",
        "parameters": [],
        "sql": "SELECT TRIGGER_SCHEMA,TRIGGER_NAME,EVENT_OBJECT_SCHEMA,EVENT_OBJECT_TABLE,ACTION_TIMING,EVENT_MANIPULATION,ACTION_ORDER,ACTION_ORIENTATION,IF(OCTET_LENGTH(ACTION_STATEMENT) BETWEEN 1 AND 16384,ACTION_STATEMENT,NULL),OCTET_LENGTH(ACTION_STATEMENT),SQL_MODE,DEFINER,CHARACTER_SET_CLIENT,COLLATION_CONNECTION,DATABASE_COLLATION FROM INFORMATION_SCHEMA.TRIGGERS ORDER BY BINARY TRIGGER_SCHEMA,BINARY TRIGGER_NAME LIMIT 10001"
      },
      {
        "id": "routine_definitions",
        "parameters": [],
        "sql": "SELECT SPECIFIC_NAME,ROUTINE_CATALOG,ROUTINE_SCHEMA,ROUTINE_NAME,ROUTINE_TYPE,DATA_TYPE,CHARACTER_MAXIMUM_LENGTH,CHARACTER_OCTET_LENGTH,NUMERIC_PRECISION,NUMERIC_SCALE,DATETIME_PRECISION,CHARACTER_SET_NAME,COLLATION_NAME,DTD_IDENTIFIER,ROUTINE_BODY,IF(OCTET_LENGTH(ROUTINE_DEFINITION) BETWEEN 1 AND 16384,ROUTINE_DEFINITION,NULL),OCTET_LENGTH(ROUTINE_DEFINITION),EXTERNAL_NAME,EXTERNAL_LANGUAGE,PARAMETER_STYLE,IS_DETERMINISTIC,SQL_DATA_ACCESS,SQL_PATH,SECURITY_TYPE,SQL_MODE,DEFINER,CHARACTER_SET_CLIENT,COLLATION_CONNECTION,DATABASE_COLLATION FROM INFORMATION_SCHEMA.ROUTINES ORDER BY BINARY ROUTINE_SCHEMA,BINARY ROUTINE_NAME,BINARY ROUTINE_TYPE LIMIT 10001"
      },
      {
        "id": "routine_parameters_and_return",
        "parameters": [],
        "sql": "SELECT SPECIFIC_CATALOG,SPECIFIC_SCHEMA,SPECIFIC_NAME,ORDINAL_POSITION,PARAMETER_MODE,PARAMETER_NAME,DATA_TYPE,DTD_IDENTIFIER,CHARACTER_MAXIMUM_LENGTH,CHARACTER_OCTET_LENGTH,NUMERIC_PRECISION,NUMERIC_SCALE,DATETIME_PRECISION,CHARACTER_SET_NAME,COLLATION_NAME FROM INFORMATION_SCHEMA.PARAMETERS ORDER BY BINARY SPECIFIC_SCHEMA,BINARY SPECIFIC_NAME,ORDINAL_POSITION LIMIT 10001"
      },
      {
        "id": "event_definitions",
        "parameters": [],
        "sql": "SELECT EVENT_SCHEMA,EVENT_NAME,DEFINER,TIME_ZONE,EVENT_BODY,IF(OCTET_LENGTH(EVENT_DEFINITION) BETWEEN 1 AND 16384,EVENT_DEFINITION,NULL),OCTET_LENGTH(EVENT_DEFINITION),EVENT_TYPE,EXECUTE_AT,INTERVAL_VALUE,INTERVAL_FIELD,STARTS,ENDS,STATUS,ON_COMPLETION,SQL_MODE,CHARACTER_SET_CLIENT,COLLATION_CONNECTION,DATABASE_COLLATION FROM INFORMATION_SCHEMA.EVENTS ORDER BY BINARY EVENT_SCHEMA,BINARY EVENT_NAME LIMIT 10001"
      },
      {
        "id": "view_definitions",
        "parameters": [],
        "sql": "SELECT TABLE_CATALOG,TABLE_SCHEMA,TABLE_NAME,IF(OCTET_LENGTH(VIEW_DEFINITION) BETWEEN 1 AND 16384,VIEW_DEFINITION,NULL),OCTET_LENGTH(VIEW_DEFINITION),CHECK_OPTION,IS_UPDATABLE,DEFINER,SECURITY_TYPE,CHARACTER_SET_CLIENT,COLLATION_CONNECTION FROM INFORMATION_SCHEMA.VIEWS ORDER BY BINARY TABLE_SCHEMA,BINARY TABLE_NAME LIMIT 10001"
      },
      {
        "id": "exact_connection_mapping",
        "parameters": [
          "holder_connection_id",
          "writer_connection_id"
        ],
        "sql": "SELECT THREAD_ID,PROCESSLIST_ID,TYPE,NAME FROM performance_schema.threads WHERE PROCESSLIST_ID IN (?,?) ORDER BY THREAD_ID"
      },
      {
        "id": "exact_metadata_lock_observation",
        "parameters": [
          "holder_thread_id",
          "writer_thread_id"
        ],
        "sql": "SELECT OBJECT_TYPE,OBJECT_SCHEMA,OBJECT_NAME,LOCK_TYPE,LOCK_DURATION,LOCK_STATUS,OWNER_THREAD_ID,OWNER_EVENT_ID FROM performance_schema.metadata_locks WHERE OWNER_THREAD_ID IN (?,?) ORDER BY OWNER_THREAD_ID,OBJECT_TYPE,OBJECT_SCHEMA,OBJECT_NAME,LOCK_TYPE,LOCK_STATUS"
      }
    ],
    "maximum_rows_per_program_kind": 10000,
    "lookahead_rows": 10001,
    "maximum_program_body_bytes": 16384,
    "rejection_rules": [
      "Reject incomplete/permission-filtered visibility even when the query succeeds and returns zero rows.",
      "Reject NULL, empty, oversize or incomplete program bodies and more than 10000 rows; never pin a truncated prefix.",
      "Preserve SQL NULL separately from empty text and preserve identity, definer, SQL mode, charset/collation, execution/security and schedule semantics.",
      "Do not narrow the program catalog by guessed system_ names or schema when asserting global absence.",
      "Capture in an exact existing disposable namespace UID/server UUID and owned schemas; retain exact cleanup and native exit.",
      "Keep program body capture local to its authorized observer; a digest is neither authorization nor a freeze lease.",
      "Bind PARAMETERS to the exact routine SPECIFIC_SCHEMA/SPECIFIC_NAME and preserve ordinal zero return metadata, IN/OUT/INOUT modes, type sizes and charset/collation.",
      "An empty metadata_locks result or disabled/unavailable instrumentation is not observed blocking and cannot establish the freeze."
    ]
  },
  "required_actual_observations": [
    {
      "id": "catalog_authoritative_sources",
      "requirement": "Review real table ownership, canonical DDL, installation/key/version, original owner/write deadline provenance, row/evidence binding, artifact state, holds, leases and all incoming uses. Supply positive expired terminal and contradictory/active/foreign-source controls. No made-up SQL columns or inherited child deadline."
    },
    {
      "id": "complete_program_visibility",
      "requirement": "In an owned disposable fixture, independently seed a trigger, procedure, function, event and view. A privileged observer must enumerate exact identities and complete non-NULL definitions, parameters/return types and compile/security context. Prove that the worker or a restricted observer can omit rows/bodies; absence without independently verified visibility must remain not_ready."
    },
    {
      "id": "program_change_after_capture",
      "requirement": "Change a trigger/routine/event after the initial capture. Prove the approved freeze blocks the change through the collector commit, or prove the full policy rejects and rolls back all group/tombstone/capacity writes. Two matching samples alone do not close the final-check-to-commit race."
    },
    {
      "id": "same_schema_table_ddl",
      "requirement": "Attempt ALTER/DROP and creation of a new reference table during the complete proposed freeze. Map exact holder/writer CONNECTION_IDs to metadata_locks; distinguish actual pending locks from permissions, syntax failures or timeouts. DDL happens only in an exact UID/server/owned test database."
    },
    {
      "id": "foreign_schema_fk_and_program",
      "requirement": "Exercise an incoming cross-schema FK and a program with cross-schema effects using separate owned test schemas. No TABLE_SCHEMA-local filter may establish global absence. Observe real metadata locks; an ordinary RR read alone is not accepted as a complete freeze."
    },
    {
      "id": "lock_tables_transaction_boundary",
      "requirement": "Use an isolated disposable sentinel to demonstrate the documented implicit commit before LOCK TABLES and loss of prior explicit locks after START TRANSACTION. Never issue these inside the collector. The GC account grant named LOCK TABLES is a permission prerequisite, not evidence that a freeze was acquired."
    },
    {
      "id": "observer_lifecycle_and_revocation",
      "requirement": "Close/reconnect the observer and revoke relevant privileges on held and new sessions. The full policy must reject loss of the original observation/freeze identity and must not silently reacquire or renew its lifetime. Record release of the original exact connection."
    },
    {
      "id": "single_gc_transaction",
      "requirement": "In an actual complete Collect fixture, inject late changes after tombstone insertion and group deletion. Verify one known commit only on success and full original rows, capacity and absent tombstone on rejection. Metadata-only capture and component tests cannot substitute for this proof."
    }
  ],
