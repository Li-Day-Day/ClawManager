  "checkpoints": [
    {
      "name": "pre_C1_history",
      "evidence": "bootstrapEntryNew invokes the original A Bootstrap inside beforeDDL with C1 absent; dProducerMySQLDB installs the requested original C1 DDL afterward. Canonical A tables are SHOW CREATE clones from the exact 96-migration ledger and retain real FKs."
    },
    {
      "name": "hidden_C1_identity",
      "evidence": "A real random run-owned account receives only eight A table grants. Metadata must show zero C1 tables and direct SELECT must return typed 1142. Actual A prefix access and exported fence rejection are both checked."
    },
    {
      "name": "history_authorization",
      "evidence": "Exact successful original operation, disabled v1/config and compatible configured domain are required. Real users revocation and synthetic current authority denial are negatives. A1 r2 now checks persistent matrix_key in initial history and final readback."
    },
    {
      "name": "late_domain_mutation",
      "evidence": "The second Authorize callback changes canonical domain epoch/row version in the original transaction; RowsAffected must be one. The rejected call is checked against full A/D row snapshots."
    },
    {
      "name": "domain_PK_gap",
      "evidence": "The original A service holds the domain absence range. A direct writer omits installation locks. performance_schema must show the exact requester/blocker, domains PRIMARY RECORD INSERT_INTENTION edge. Cancellation releases it and only the deliberate domain row may remain."
    },
    {
      "name": "binding_and_commit_unknown",
      "evidence": "Wrong context/transaction negatives call the exported fence. COMMIT acknowledgement is hidden only after actual driver Commit succeeds; retry must be read-only history without a second reservation."
    },
    {
      "name": "cleanup",
      "evidence": "The low-privilege connection closes before its account is dropped. Per-case DB teardown confirms absence under the pinned server UUID. Gap workers have bounded cancel/rollback/wait cleanup; receiver rejects CLEANUP_PENDING, failures and skips."
    },
    {
      "name": "receiver",
      "evidence": "Exactly 22 child runs/passes and scoped fixture/DomainOpener/variant/visibility/mutation/waitgraph/result/cleanup markers are required. Parent PASS, pinned migrations/images/binaries, UID, cleanup and exit order are checked."
    }
  ],
