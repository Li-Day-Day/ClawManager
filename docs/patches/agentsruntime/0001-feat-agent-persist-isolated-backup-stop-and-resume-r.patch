diff --git a/clawmanager-agent/slots/backup.go b/clawmanager-agent/slots/backup.go
new file mode 100644
index 0000000..2eac63f
--- /dev/null
+++ b/clawmanager-agent/slots/backup.go
@@ -0,0 +1,330 @@
+package slots
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"runtime"
+	"strconv"
+	"time"
+
+	"github.com/iamlovingit/clawmanager-agent/gateway"
+)
+
+// Both the slot journal and the shared per-instance writer ledger retain the
+// operation. A crash never converts a pending operation into a stop proof.
+type backupRecord struct {
+	Request gateway.BackupRequest  `json:"request"`
+	State   string                 `json:"state"`
+	Stop    *gateway.BackupReceipt `json:"stop,omitempty"`
+	Resume  *gateway.BackupReceipt `json:"resume,omitempty"`
+}
+
+func (b *book) backupActive() bool { return b.Backup != nil && b.Backup.State != "completed" }
+
+func decodeBackup(data []byte, value any) error {
+	d := json.NewDecoder(bytes.NewReader(data))
+	d.DisallowUnknownFields()
+	if err := d.Decode(value); err != nil {
+		return err
+	}
+	var extra any
+	if d.Decode(&extra) != io.EOF {
+		return fmt.Errorf("trailing JSON")
+	}
+	return nil
+}
+
+// Caller holds w.mu throughout dispatch and persistence. Ordinary creates,
+// deletes, upgrades and pending cancellations use this same mutex and fence.
+func (w *Worker) serveBackup(out http.ResponseWriter, r *http.Request) {
+	if r.URL.Path == "/v1/backup/capabilities" {
+		port, err := strconv.Atoi(r.URL.Query().Get("gateway_port"))
+		if r.Method != http.MethodGet {
+			out.WriteHeader(405)
+			return
+		}
+		if err != nil || port != w.cfg.GatewayPortStart {
+			out.WriteHeader(400)
+			return
+		}
+		writeJSON(out, 200, map[string]any{"protocol": gateway.BackupProtocol, "namespace": w.cfg.Namespace, "pod_uid": w.cfg.PodUID,
+			"agent_epoch": w.manager.StopCapabilities().AgentEpoch, "slot": w.slotName, "gateway_port": port,
+			"confirmation_scope": gateway.BackupStopScope, "supported": runtime.GOOS == "linux" && w.cfg.PodUID != "" && w.cfg.Namespace != "" && w.manager.IsolatedGatewayLifecycle(),
+			"durable_reservation": true, "agent_restart_reconciliation": false})
+		return
+	}
+	if r.Method != http.MethodPost {
+		out.WriteHeader(405)
+		return
+	}
+	if runtime.GOOS != "linux" {
+		out.WriteHeader(http.StatusNotImplemented)
+		return
+	}
+	data, err := io.ReadAll(io.LimitReader(r.Body, (1<<20)+1))
+	if err != nil || len(data) > 1<<20 {
+		out.WriteHeader(400)
+		return
+	}
+	var req gateway.BackupRequest
+	var resume gateway.BackupResumeRequest
+	if r.URL.Path == "/v1/backup/resume" {
+		err = decodeBackup(data, &resume)
+		req = resume.Request
+	} else {
+		err = decodeBackup(data, &req)
+	}
+	if err != nil || !req.Valid() || req.Namespace != w.cfg.Namespace || req.PodUID != w.cfg.PodUID || req.RuntimeType != w.cfg.RuntimeType || req.GatewayPort != w.cfg.GatewayPortStart || req.AgentEpoch != w.manager.StopCapabilities().AgentEpoch {
+		http.Error(out, "invalid backup identity", 400)
+		return
+	}
+	if w.book.quarantined || w.lease == nil {
+		http.Error(out, "backup writer requires reconciliation", 409)
+		return
+	}
+	ctx, cancel := context.WithTimeout(r.Context(), 30*time.Second)
+	defer cancel()
+	var receipt *gateway.BackupReceipt
+	switch r.URL.Path {
+	case "/v1/backup/stop":
+		receipt, err = w.stopForBackup(ctx, req)
+	case "/v1/backup/resume":
+		receipt, err = w.resumeForBackup(ctx, resume)
+	case "/v1/backup/state":
+		receipt, err = w.backupState(req)
+	case "/v1/backup/complete":
+		receipt, err = w.completeBackup(req)
+	default:
+		out.WriteHeader(404)
+		return
+	}
+	if err != nil {
+		http.Error(out, "backup transition is not confirmed", 409)
+		return
+	}
+	if receipt == nil {
+		writeJSON(out, 202, map[string]string{"state": "resuming"})
+		return
+	}
+	writeJSON(out, 200, receipt)
+}
+
+// Any durability error can include an unknown rename/fsync outcome. Retain the
+// lease and quarantine instead of rolling memory back and dispatching again.
+func (w *Worker) saveBackup(next backupRecord, generation int) error {
+	previous, err := readWriter(w.writerPath)
+	if err != nil {
+		w.book.quarantined = true
+		return err
+	}
+	r := next.Request
+	if previous.InstanceID != r.InstanceID || previous.UserID != r.UserID || previous.RuntimeType != r.RuntimeType || previous.PodUID != r.PodUID || previous.Slot != w.slotName {
+		w.book.quarantined = true
+		return fmt.Errorf("shared writer identity changed")
+	}
+	if previous.Backup == nil {
+		if next.State != "stopping" || previous.State != "running" || previous.Generation != r.Generation {
+			return fmt.Errorf("writer cannot reserve backup")
+		}
+	} else if previous.Backup.Request != r {
+		return fmt.Errorf("backup operation changed")
+	}
+	previous.Generation, previous.State, previous.Backup = generation, "backup_"+next.State, &next
+	if err = atomicJSON(w.writerPath, previous); err != nil {
+		w.book.quarantined = true
+		return err
+	}
+	w.book.Backup = &next
+	if err = w.book.save(); err != nil {
+		w.book.quarantined = true
+	}
+	return err
+}
+
+func (w *Worker) backupMatches(req gateway.BackupRequest) error {
+	if w.book.Backup == nil || w.book.Backup.Request != req {
+		return fmt.Errorf("different backup operation")
+	}
+	stored, err := readWriter(w.writerPath)
+	if err != nil || stored.Backup == nil || stored.Backup.Request != req || stored.State != "backup_"+w.book.Backup.State || stored.Generation != w.book.Assignment.Generation || stored.PodUID != req.PodUID || stored.Slot != w.slotName || stored.InstanceID != req.InstanceID || stored.UserID != req.UserID || stored.RuntimeType != req.RuntimeType {
+		return fmt.Errorf("shared backup reservation changed")
+	}
+	return nil
+}
+
+func (w *Worker) stopForBackup(ctx context.Context, req gateway.BackupRequest) (*gateway.BackupReceipt, error) {
+	if w.book.backupActive() {
+		if err := w.backupMatches(req); err != nil {
+			return nil, err
+		}
+		if w.book.Backup.State == "stopped" {
+			return w.book.Backup.Stop, nil
+		}
+		if w.book.Backup.State != "stopping" {
+			return nil, fmt.Errorf("source already resumed")
+		}
+	} else {
+		a := w.book.Assignment
+		s, ok := w.manager.GatewayState(req.GatewayID)
+		if a == nil || a.GatewayID != req.GatewayID || a.UserID != req.UserID || a.Generation != req.Generation || !ok || s.State != "running" || s.PID != req.ExpectedPID {
+			return nil, fmt.Errorf("source identity changed")
+		}
+		if err := w.saveBackup(backupRecord{Request: req, State: "stopping"}, req.Generation); err != nil {
+			return nil, err
+		}
+	}
+	if err := w.manager.StopGatewayForBackup(ctx, req); err != nil {
+		return nil, err
+	}
+	receipt := &gateway.BackupReceipt{Request: req, State: "stopped", Scope: gateway.BackupStopScope, ConfirmedAt: time.Now().UTC()}
+	w.book.Assignment.State = "stopped"
+	if err := w.saveBackup(backupRecord{Request: req, State: "stopped", Stop: receipt}, req.Generation); err != nil {
+		return nil, err
+	}
+	return receipt, nil
+}
+
+func (w *Worker) resumeForBackup(ctx context.Context, input gateway.BackupResumeRequest) (*gateway.BackupReceipt, error) {
+	req, next := input.Request, input.Restart
+	if err := w.backupMatches(req); err != nil {
+		return nil, err
+	}
+	digest, err := gateway.BackupRestartDigest(next)
+	if err != nil || digest != req.RestartSHA256 || next.PodUID != req.PodUID || next.AgentType != req.RuntimeType || next.InstanceID != req.InstanceID || next.UserID != req.UserID || next.Generation != req.ResumeGeneration || next.GatewayPort != req.GatewayPort || next.PortRange.Start != req.GatewayPort || next.PortRange.End != w.cfg.GatewayPortEnd || next.UID <= 0 || next.GID <= 0 || !matchingNetworkProfile(w.cfg.NetworkSecurityProfile, next.SecurityProfile) {
+		return nil, fmt.Errorf("restart differs from reserved payload")
+	}
+	if _, err := gateway.ValidateWorkspacePath(w.cfg.WorkspaceRoot, w.cfg.RuntimeType, next); err != nil {
+		return nil, err
+	}
+	if w.cfg.NetworkSecurityProfile != "" {
+		if _, err := validateNetworkAssignment(w.cfg, next, next.GatewayPort); err != nil {
+			return nil, err
+		}
+	}
+	if w.book.Backup.State == "resuming" || w.book.Backup.State == "resumed" {
+		return w.backupState(req)
+	}
+	if w.book.Backup.State != "stopped" || w.book.Backup.Stop == nil || next.WorkspacePath != w.writerRequest.WorkspacePath || next.UID != w.writerRequest.UID || next.GID != w.writerRequest.GID {
+		return nil, fmt.Errorf("source stop unconfirmed")
+	}
+	if len(w.manager.GatewayStates()) != 0 {
+		return nil, fmt.Errorf("slot contains another writer")
+	}
+	journal := *w.book.Backup
+	journal.State = "resuming"
+	w.book.Assignment = &Assignment{GatewayID: fmt.Sprintf("gw-%d-%d", next.InstanceID, next.Generation), InstanceID: next.InstanceID, UserID: next.UserID, Generation: next.Generation, State: "starting"}
+	w.book.Digest = digest
+	if err := w.saveBackup(journal, next.Generation); err != nil {
+		return nil, err
+	}
+	w.writerRequest = next
+	// The dispatch is durable before this call. Subsequent retries only observe;
+	// a missing or failed start cannot cause a second CreateGateway invocation.
+	if _, err := w.manager.CreateGateway(ctx, next); err != nil {
+		return nil, err
+	}
+	return w.backupState(req)
+}
+
+func (w *Worker) backupState(req gateway.BackupRequest) (*gateway.BackupReceipt, error) {
+	if err := w.backupMatches(req); err != nil {
+		return nil, err
+	}
+	b := w.book.Backup
+	if b.State == "stopped" {
+		if len(w.manager.GatewayStates()) != 0 || b.Stop == nil {
+			return nil, fmt.Errorf("stopped slot changed")
+		}
+		return b.Stop, nil
+	}
+	if b.State != "resuming" && b.State != "resumed" {
+		return nil, fmt.Errorf("stop unconfirmed")
+	}
+	s, ok := w.manager.GatewayState(fmt.Sprintf("gw-%d-%d", req.InstanceID, req.ResumeGeneration))
+	if !ok {
+		return nil, fmt.Errorf("restart dispatch outcome unknown")
+	}
+	if s.InstanceID != req.InstanceID || s.UserID != req.UserID || s.Generation != req.ResumeGeneration || s.Port != req.GatewayPort {
+		return nil, fmt.Errorf("resumed identity changed")
+	}
+	if s.State != "running" || s.PID <= 0 {
+		return nil, nil
+	}
+	if b.Resume != nil {
+		if b.Resume.PID != s.PID {
+			return nil, fmt.Errorf("resumed process changed")
+		}
+		return b.Resume, nil
+	}
+	next := *b
+	next.State = "resumed"
+	next.Resume = &gateway.BackupReceipt{Request: req, State: "resumed", Scope: gateway.BackupStopScope, PID: s.PID, ConfirmedAt: time.Now().UTC()}
+	w.book.Assignment.State = "running"
+	if err := w.saveBackup(next, req.ResumeGeneration); err != nil {
+		return nil, err
+	}
+	return next.Resume, nil
+}
+
+// The controller calls complete only after its source-binding recovery CAS has
+// committed. Until then even a healthy successor remains reserved to this task.
+func (w *Worker) completeBackup(req gateway.BackupRequest) (*gateway.BackupReceipt, error) {
+	if w.book.Backup != nil && w.book.Backup.Request == req && w.book.Backup.State == "completed" {
+		return w.book.Backup.Resume, nil
+	}
+	receipt, err := w.backupState(req)
+	if err != nil || receipt == nil || receipt.State != "resumed" {
+		return nil, fmt.Errorf("resume unconfirmed")
+	}
+	stored, err := readWriter(w.writerPath)
+	if err != nil {
+		return nil, err
+	}
+	stored.State, stored.Backup = "running", nil
+	if err = atomicJSON(w.writerPath, stored); err != nil {
+		w.book.quarantined = true
+		return nil, err
+	}
+	w.book.Backup.State = "completed"
+	if err = w.book.save(); err != nil {
+		w.book.quarantined = true
+		return nil, err
+	}
+	return receipt, nil
+}
+
+func (p *Pool) serveBackup(out http.ResponseWriter, r *http.Request, body []byte) {
+	var port int
+	if r.URL.Path == "/v1/backup/capabilities" {
+		port, _ = strconv.Atoi(r.URL.Query().Get("gateway_port"))
+	} else {
+		var req gateway.BackupRequest
+		if r.URL.Path == "/v1/backup/resume" {
+			var input gateway.BackupResumeRequest
+			if decodeBackup(body, &input) != nil {
+				out.WriteHeader(400)
+				return
+			}
+			req = input.Request
+		} else if decodeBackup(body, &req) != nil {
+			out.WriteHeader(400)
+			return
+		}
+		if !req.Valid() || req.Namespace != p.cfg.Namespace || req.PodUID != p.cfg.PodUID || req.RuntimeType != p.cfg.RuntimeType {
+			out.WriteHeader(400)
+			return
+		}
+		port = req.GatewayPort
+	}
+	offset := port - p.cfg.GatewayPortStart
+	if offset < 0 || offset%p.cfg.GatewayPortBlockSize != 0 || offset/p.cfg.GatewayPortBlockSize >= p.count {
+		out.WriteHeader(400)
+		return
+	}
+	// Do not rewrite the restart payload: the frozen digest covers every field.
+	p.forward(out, r, offset/p.cfg.GatewayPortBlockSize, body)
+}
