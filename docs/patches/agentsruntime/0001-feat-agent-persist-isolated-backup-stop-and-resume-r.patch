diff --git a/clawmanager-agent/gateway/backup_protocol.go b/clawmanager-agent/gateway/backup_protocol.go
new file mode 100644
index 0000000..f905dd4
--- /dev/null
+++ b/clawmanager-agent/gateway/backup_protocol.go
@@ -0,0 +1,103 @@
+package gateway
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"time"
+)
+
+const BackupProtocol = "isolated-backup.v1"
+const BackupStopScope = "instance_pid_namespaces_and_mounts"
+
+// BackupRequest binds one source writer and exactly one authorized successor.
+// RestartSHA256 hashes json.Marshal(CreateGatewayRequest), including its secret
+// configuration. Only the digest, never that configuration, enters the ledger.
+type BackupRequest struct {
+	Protocol         string `json:"protocol"`
+	Namespace        string `json:"namespace"`
+	PodUID           string `json:"pod_uid"`
+	AgentEpoch       string `json:"agent_epoch"`
+	OperationID      string `json:"operation_id"`
+	RuntimeType      string `json:"runtime_type"`
+	InstanceID       int    `json:"instance_id"`
+	UserID           int    `json:"user_id"`
+	Generation       int    `json:"generation"`
+	GatewayID        string `json:"gateway_id"`
+	GatewayPort      int    `json:"gateway_port"`
+	ExpectedPID      int    `json:"expected_pid"`
+	ResumeGeneration int    `json:"resume_generation"`
+	RestartSHA256    string `json:"restart_sha256"`
+}
+
+func lowerHex(value string, size int) bool {
+	b, err := hex.DecodeString(value)
+	return err == nil && len(b) == size && hex.EncodeToString(b) == value
+}
+
+func (r BackupRequest) Valid() bool {
+	return r.Protocol == BackupProtocol && r.Namespace != "" && r.PodUID != "" &&
+		lowerHex(r.AgentEpoch, 16) && lowerHex(r.OperationID, 16) && lowerHex(r.RestartSHA256, 32) &&
+		r.RuntimeType != "" && r.InstanceID > 0 && r.UserID > 0 && r.Generation > 0 &&
+		r.ResumeGeneration > r.Generation && r.ExpectedPID > 0 && r.GatewayPort > 0 && r.GatewayPort <= 65535 &&
+		r.GatewayID == fmt.Sprintf("gw-%d-%d", r.InstanceID, r.Generation)
+}
+
+type BackupReceipt struct {
+	Request     BackupRequest `json:"request"`
+	State       string        `json:"state"`
+	Scope       string        `json:"confirmation_scope"`
+	PID         int           `json:"pid,omitempty"`
+	ConfirmedAt time.Time     `json:"confirmed_at"`
+}
+
+type BackupResumeRequest struct {
+	Request BackupRequest        `json:"request"`
+	Restart CreateGatewayRequest `json:"restart"`
+}
+
+func BackupRestartDigest(req CreateGatewayRequest) (string, error) {
+	b, err := json.Marshal(req)
+	if err != nil {
+		return "", err
+	}
+	h := sha256.Sum256(b)
+	return hex.EncodeToString(h[:]), nil
+}
+
+// StopGatewayForBackup pins and cancels the lifecycle under the same mutex.
+// Missing gateways are not evidence. The lifecycle owner must join auxiliary
+// commands, reap the isolated process tree and release execution mounts.
+func (m *GatewayManager) StopGatewayForBackup(ctx context.Context, req BackupRequest) error {
+	if !req.Valid() || !m.IsolatedGatewayLifecycle() || req.Namespace != m.cfg.Namespace || req.PodUID != m.cfg.PodUID || req.AgentEpoch != m.stopEpoch || req.RuntimeType != m.cfg.RuntimeType {
+		return ErrGatewayStopConflict
+	}
+	m.mu.Lock()
+	record := m.gateways[req.GatewayID]
+	if record == nil {
+		m.mu.Unlock()
+		return ErrGatewayStopConflict
+	}
+	s := record.state
+	if s.InstanceID != req.InstanceID || s.UserID != req.UserID || s.Generation != req.Generation || s.Port != req.GatewayPort || (record.stopOperation != "" && record.stopOperation != req.OperationID) {
+		m.mu.Unlock()
+		return ErrGatewayStopConflict
+	}
+	if record.stopOperation == "" && (s.State != "running" || s.PID != req.ExpectedPID || record.process.PID != req.ExpectedPID) {
+		m.mu.Unlock()
+		return ErrGatewayStopConflict
+	}
+	record.stopOperation = req.OperationID
+	record.cancel()
+	m.mu.Unlock()
+	if err := m.deleteIsolatedGateway(ctx, req.GatewayID); err != nil {
+		return err
+	}
+	if _, exists := m.GatewayState(req.GatewayID); exists {
+		return errors.New("backup writer still present")
+	}
+	return nil
+}
diff --git a/clawmanager-agent/gateway/backup_protocol_test.go b/clawmanager-agent/gateway/backup_protocol_test.go
new file mode 100644
index 0000000..1e8f50a
--- /dev/null
+++ b/clawmanager-agent/gateway/backup_protocol_test.go
@@ -0,0 +1,49 @@
+package gateway
+
+import (
+	"context"
+	"strings"
+	"sync/atomic"
+	"testing"
+)
+
+func TestBackupStopPinsActualProcessBeforeCancelling(t *testing.T) {
+	var stops atomic.Int32
+	m := isolatedTestManager(t, isolatedTestProfile{}, isolatedTestStarter{start: func(GatewayStartSpec) (ManagedProcess, error) {
+		return ManagedProcess{PID: 101, Stop: func(context.Context) error { stops.Add(1); return nil }}, nil
+	}})
+	m.cfg.Namespace, m.cfg.PodUID = "tenant-system", "source-pod"
+	created, err := m.CreateGateway(context.Background(), isolatedRequest(m, 7, 5, 20000))
+	if err != nil {
+		t.Fatal(err)
+	}
+	awaitIsolatedState(t, m, created.GatewayID, "running")
+	req := BackupRequest{Protocol: BackupProtocol, Namespace: m.cfg.Namespace, PodUID: m.cfg.PodUID, AgentEpoch: m.stopEpoch, OperationID: strings.Repeat("a", 32), RuntimeType: "hermes", InstanceID: 7, UserID: 1, Generation: 5, GatewayID: "gw-7-5", GatewayPort: 20000, ExpectedPID: 102, ResumeGeneration: 9, RestartSHA256: strings.Repeat("b", 64)}
+	if err := m.StopGatewayForBackup(context.Background(), req); err == nil || stops.Load() != 0 {
+		t.Fatal("stale PID cancelled current process")
+	}
+	req.ExpectedPID = 101
+	if err := m.StopGatewayForBackup(context.Background(), req); err != nil {
+		t.Fatal(err)
+	}
+	if stops.Load() < 1 || len(m.GatewayStates()) != 0 {
+		t.Fatal("cleanup did not finish")
+	}
+	if err := m.StopGatewayForBackup(context.Background(), req); err == nil {
+		t.Fatal("absence converted into fresh stop proof")
+	}
+}
+
+func TestBackupRequestRequiresReservedSuccessorAndCanonicalHashes(t *testing.T) {
+	r := BackupRequest{Protocol: BackupProtocol, Namespace: "n", PodUID: "p", AgentEpoch: strings.Repeat("a", 32), OperationID: strings.Repeat("b", 32), RuntimeType: "openclaw", InstanceID: 7, UserID: 2, Generation: 5, GatewayID: "gw-7-5", GatewayPort: 20000, ExpectedPID: 42, ResumeGeneration: 9, RestartSHA256: strings.Repeat("c", 64)}
+	if !r.Valid() {
+		t.Fatal("valid request rejected")
+	}
+	for _, mutate := range []func(*BackupRequest){func(r *BackupRequest) { r.ResumeGeneration = 5 }, func(r *BackupRequest) { r.ExpectedPID = 0 }, func(r *BackupRequest) { r.RestartSHA256 = strings.Repeat("C", 64) }, func(r *BackupRequest) { r.OperationID = "" }, func(r *BackupRequest) { r.GatewayID = "gw-8-5" }, func(r *BackupRequest) { r.Namespace = "" }} {
+		bad := r
+		mutate(&bad)
+		if bad.Valid() {
+			t.Fatal("invalid request accepted")
+		}
+	}
+}
