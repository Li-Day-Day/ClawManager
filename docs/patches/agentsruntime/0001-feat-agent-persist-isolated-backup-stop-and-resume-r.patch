+func TestBackupFailedCleanupNeverReturnsProof(t *testing.T) {
+	w, process, req, restart := newBackupWorker(t)
+	process.failStop.Store(true)
+	if out := backupHTTP(w, "POST", "/v1/backup/stop", "control", req); out.Code != 409 {
+		t.Fatal("failed namespace teardown confirmed")
+	}
+	if w.book.Backup == nil || w.book.Backup.Stop != nil || w.book.Backup.State != "stopping" {
+		t.Fatal("failed cleanup generated proof")
+	}
+	if out := backupHTTP(w, "POST", "/v1/backup/resume", "control", gateway.BackupResumeRequest{Request: req, Restart: restart}); out.Code != 409 || process.starts.Load() != 1 {
+		t.Fatal("unconfirmed stop resumed")
+	}
+	if err := claimWriter(w.writerPath, restart, "slot-other"); err == nil {
+		t.Fatal("failed stop released writer")
+	}
+}
+
+func TestBackupUncertainRestartDispatchIsNeverRepeated(t *testing.T) {
+	w, process, req, restart := newBackupWorker(t)
+	if out := backupHTTP(w, "POST", "/v1/backup/stop", "control", req); out.Code != 200 {
+		t.Fatal(out.Code)
+	}
+	// Force CreateGateway to reject after the durable dispatch record. Even
+	// after that transient condition clears, a retry may only reconcile.
+	w.manager.SetDraining(true)
+	input := gateway.BackupResumeRequest{Request: req, Restart: restart}
+	if out := backupHTTP(w, "POST", "/v1/backup/resume", "control", input); out.Code != 409 {
+		t.Fatal("failed dispatch confirmed")
+	}
+	w.manager.SetDraining(false)
+	for i := 0; i < 3; i++ {
+		if out := backupHTTP(w, "POST", "/v1/backup/resume", "control", input); out.Code != 409 {
+			t.Fatal("unknown dispatch retried")
+		}
+	}
+	if process.starts.Load() != 1 || w.book.Backup.State != "resuming" {
+		t.Fatal("unknown dispatch resurrected writer")
+	}
+}
