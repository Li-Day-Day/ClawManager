+//go:build linux
+
+package slots
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/iamlovingit/clawmanager-agent/control"
+	"github.com/iamlovingit/clawmanager-agent/gateway"
+	"github.com/iamlovingit/clawmanager-agent/runtime/generic"
+)
+
+type backupStarter struct {
+	starts, stops atomic.Int32
+	failStop      atomic.Bool
+}
+
+func (p *backupStarter) StartGateway(context.Context, gateway.GatewayStartSpec) (gateway.ManagedProcess, error) {
+	pid := int(p.starts.Add(1)) + 100
+	return gateway.ManagedProcess{PID: pid, Stop: func(context.Context) error {
+		p.stops.Add(1)
+		if p.failStop.Load() {
+			return errors.New("injected namespace cleanup failure")
+		}
+		return nil
+	}}, nil
+}
+
+func backupHTTP(w http.Handler, method, path, token string, input any) *httptest.ResponseRecorder {
+	raw, _ := json.Marshal(input)
+	r := httptest.NewRequest(method, path, bytes.NewReader(raw))
+	r.Header.Set(gateway.ControlTokenHeader, token)
+	out := httptest.NewRecorder()
+	w.ServeHTTP(out, r)
+	return out
+}
+
+func newBackupWorker(t *testing.T) (*Worker, *backupStarter, gateway.BackupRequest, gateway.CreateGatewayRequest) {
+	t.Helper()
+	cfg := gateway.Config{ControlToken: "control", RuntimeType: "openclaw", Runtime: generic.NewProfile("openclaw"), Namespace: "tenant-system", PodUID: "pod-original", WorkspaceRoot: t.TempDir(), AgentDataDir: t.TempDir(), GatewayPortStart: 20000, GatewayPortEnd: 20002, GatewayPortBlockSize: 3, Capacity: 1, IsolatedLifecycle: true}
+	w, err := NewWorker(cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	process := &backupStarter{}
+	w.manager = gateway.NewGatewayManager(cfg, process, gateway.NewPortAllocator(func(int) bool { return false }))
+	w.manager.SetHealthChecker(gateway.NewNoopGatewayHealthChecker())
+	w.handler = control.NewControlHandler(cfg, w.manager, discardReporter{})
+	t.Cleanup(func() {
+		process.failStop.Store(false)
+		ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+		defer cancel()
+		_ = w.Shutdown(ctx)
+		if w.lease != nil {
+			_ = w.lease.Close()
+		}
+	})
+	create := gateway.CreateGatewayRequest{PodUID: cfg.PodUID, AgentType: cfg.RuntimeType, InstanceID: 7, UserID: 2, Generation: 5, GatewayPort: 20000, PortRange: gateway.PortRange{Start: 20000, End: 20002}, UID: 1001, GID: 1001, WorkspacePath: filepath.Join(cfg.WorkspaceRoot, "openclaw", "user-2", "instance-7"), Env: map[string]string{"MODEL_KEY": "secret-config-sentinel"}}
+	if out := backupHTTP(w, "POST", "/v1/gateways", "control", create); out.Code != 200 {
+		t.Fatalf("create=%d: %s", out.Code, out.Body.String())
+	}
+	deadline := time.Now().Add(3 * time.Second)
+	for {
+		s, ok := w.manager.GatewayState("gw-7-5")
+		if ok && s.State == "running" {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatalf("gateway never ready: %+v", s)
+		}
+		time.Sleep(time.Millisecond)
+	}
+	create.Generation = 9
+	digest, err := gateway.BackupRestartDigest(create)
+	if err != nil {
+		t.Fatal(err)
+	}
+	req := gateway.BackupRequest{Protocol: gateway.BackupProtocol, Namespace: cfg.Namespace, PodUID: cfg.PodUID, AgentEpoch: w.manager.StopCapabilities().AgentEpoch, OperationID: strings.Repeat("a", 32), RuntimeType: cfg.RuntimeType, InstanceID: 7, UserID: 2, Generation: 5, GatewayID: "gw-7-5", GatewayPort: 20000, ExpectedPID: 101, ResumeGeneration: 9, RestartSHA256: digest}
+	return w, process, req, create
+}
+
+func TestBackupStopResumeRetainsDurableWriterReservation(t *testing.T) {
+	w, process, req, restart := newBackupWorker(t)
+	first := backupHTTP(w, "POST", "/v1/backup/stop", "control", req)
+	if first.Code != 200 {
+		t.Fatalf("stop=%d: %s", first.Code, first.Body.String())
+	}
+	if second := backupHTTP(w, "POST", "/v1/backup/stop", "control", req); second.Code != 200 || second.Body.String() != first.Body.String() {
+		t.Fatal("stop retry changed receipt")
+	}
+	if process.starts.Load() != 1 || w.lease == nil {
+		t.Fatal("stop lost reservation")
+	}
+	for _, route := range []string{"/v1/gateways", "/v1/gateways/gw-7-5/stop", "/v1/gateways/cancel-pending", "/v1/openclaw/upgrade", "/v1/drain"} {
+		if out := backupHTTP(w, "POST", route, "control", restart); out.Code != 409 {
+			t.Fatalf("ordinary writer bypass: %s = %d", route, out.Code)
+		}
+	}
+	if err := claimWriter(w.writerPath, restart, "slot-other"); err == nil {
+		t.Fatal("other slot claimed backup-reserved writer")
+	}
+	if err := stopWriter(w.writerPath, w.writerRequest, w.slotName); err == nil {
+		t.Fatal("ordinary stop released backup reservation")
+	}
+	changed := req
+	changed.OperationID = strings.Repeat("b", 32)
+	if out := backupHTTP(w, "POST", "/v1/backup/stop", "control", changed); out.Code != 409 {
+		t.Fatal("operation replacement accepted")
+	}
+	bad := restart
+	bad.MemoryMB++
+	if out := backupHTTP(w, "POST", "/v1/backup/resume", "control", gateway.BackupResumeRequest{Request: req, Restart: bad}); out.Code != 409 || process.starts.Load() != 1 {
+		t.Fatal("changed restart config dispatched")
+	}
+	resuming := gateway.BackupResumeRequest{Request: req, Restart: restart}
+	if out := backupHTTP(w, "POST", "/v1/backup/resume", "control", resuming); out.Code != 200 && out.Code != 202 {
+		t.Fatalf("resume=%d: %s", out.Code, out.Body.String())
+	}
+	deadline := time.Now().Add(3 * time.Second)
+	for {
+		out := backupHTTP(w, "POST", "/v1/backup/state", "control", req)
+		if out.Code == 200 {
+			break
+		}
+		if out.Code != 202 || time.Now().After(deadline) {
+			t.Fatalf("resume proof=%d %s", out.Code, out.Body.String())
+		}
+		time.Sleep(time.Millisecond)
+	}
+	for i := 0; i < 3; i++ {
+		if out := backupHTTP(w, "POST", "/v1/backup/resume", "control", resuming); out.Code != 200 {
+			t.Fatal("resume retry unavailable")
+		}
+	}
+	if process.starts.Load() != 2 {
+		t.Fatalf("duplicate dispatches: %d", process.starts.Load())
+	}
+	if out := backupHTTP(w, "POST", "/v1/backup/stop", "control", req); out.Code != 409 {
+		t.Fatal("historical stop presented as current barrier")
+	}
+	for _, name := range []string{w.writerPath, w.book.path} {
+		data, err := os.ReadFile(name)
+		if err != nil || bytes.Contains(data, []byte("secret-config-sentinel")) {
+			t.Fatal("configuration escaped into proof ledger")
+		}
+	}
+	if out := backupHTTP(w, "POST", "/v1/backup/complete", "control", req); out.Code != 200 {
+		t.Fatal("completion failed")
+	}
+	if out := backupHTTP(w, "POST", "/v1/backup/complete", "control", req); out.Code != 200 {
+		t.Fatal("completion retry failed")
+	}
+	if out := backupHTTP(w, "DELETE", "/v1/gateways/gw-7-9", "control", nil); out.Code != 200 {
+		t.Fatalf("completed reservation not released: %d", out.Code)
+	}
+}
