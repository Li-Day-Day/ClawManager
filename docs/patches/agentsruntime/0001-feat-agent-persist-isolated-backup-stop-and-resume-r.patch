+func TestBackupRejectsChangedIdentityBeforeMutation(t *testing.T) {
+	w, process, req, _ := newBackupWorker(t)
+	for _, change := range []func(*gateway.BackupRequest){
+		func(r *gateway.BackupRequest) { r.PodUID = "replacement" }, func(r *gateway.BackupRequest) { r.Namespace = "another" },
