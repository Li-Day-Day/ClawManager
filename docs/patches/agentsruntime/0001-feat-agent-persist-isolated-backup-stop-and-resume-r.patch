+func TestBackupRestartAndPersistenceFailuresRemainQuarantined(t *testing.T) {
+	t.Run("restart after confirmed stop", func(t *testing.T) {
+		w, _, req, restart := newBackupWorker(t)
+		if out := backupHTTP(w, "POST", "/v1/backup/stop", "control", req); out.Code != 200 {
+			t.Fatal(out.Code)
+		}
+		reloaded, err := openBook(w.cfg.AgentDataDir)
+		if err != nil || !reloaded.quarantined || reloaded.Backup.Stop == nil {
+			t.Fatal("restart fabricated live proof or lost evidence")
+		}
+		w.book = reloaded
+		if out := backupHTTP(w, "POST", "/v1/backup/state", "control", req); out.Code != 409 {
+			t.Fatal("restart claimed current stop without reconciliation")
+		}
+		_ = w.lease.Close()
+		w.lease = nil
+		if err := claimWriter(w.writerPath, restart, "other-pod"); err == nil {
+			t.Fatal("crash released durable reservation")
+		}
+	})
+	t.Run("intent sync failure", func(t *testing.T) {
+		w, process, req, _ := newBackupWorker(t)
+		w.book.path = filepath.Join(t.TempDir(), "missing", "book.json")
+		if out := backupHTTP(w, "POST", "/v1/backup/stop", "control", req); out.Code != 409 || !w.book.quarantined || process.stops.Load() != 0 {
+			t.Fatal("stop dispatched before durable intent")
+		}
+	})
+}
+
+func TestBackupPoolPreservesFrozenPayloadAndSlotBoundary(t *testing.T) {
+	w, _, req, restart := newBackupWorker(t)
+	cfg := w.cfg
+	cfg.GatewayPortStart = 19997
+	cfg.GatewayPortEnd = 20002
+	var calls int
+	p, err := NewPool(cfg, 2, func(_ context.Context, slot int, method, path string, body []byte) (int, []byte, error) {
+		calls++
+		if slot != 1 {
+			t.Errorf("wrong slot %d", slot)
+		}
+		if path == "/v1/backup/resume" {
+			var input gateway.BackupResumeRequest
+			if decodeBackup(body, &input) != nil {
+				t.Fatal("invalid forwarded payload")
+			}
+			hash, _ := gateway.BackupRestartDigest(input.Restart)
+			if hash != req.RestartSHA256 {
+				t.Error("pool rewrote frozen payload")
+			}
+		}
+		return 200, []byte(`{}`), nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if out := backupHTTP(p, "GET", "/v1/backup/capabilities?gateway_port=20000", "control", nil); out.Code != 200 {
+		t.Fatal(out.Code)
+	}
+	if out := backupHTTP(p, "POST", "/v1/backup/resume", "control", gateway.BackupResumeRequest{Request: req, Restart: restart}); out.Code != 200 {
+		t.Fatal(out.Code)
+	}
+	if out := backupHTTP(p, "GET", "/v1/backup/capabilities?gateway_port=20001", "control", nil); out.Code != 400 || calls != 2 {
+		t.Fatal("non-slot port forwarded")
+	}
+}
