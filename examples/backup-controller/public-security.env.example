# Reference-only template. Replace pins from an independent deployment review.
# Keep the resolved file and every credential outside the Git checkout.
# This does not configure SQL credentials, leader election, or provider ACLs.
SYSTEM_BACKUP_EXECUTION_PROTOCOL=public-v1
SYSTEM_BACKUP_PUBLIC_CONFIG_FILE=/run/system-backup/public-deployment.json
SYSTEM_BACKUP_PUBLIC_CONFIG_SHA256=REPLACE_WITH_REVIEWED_CONFIG_SHA256
SYSTEM_BACKUP_FORWARD_GRANT_SHA256=REPLACE_WITH_REVIEWED_FORWARD_GRANT_SHA256
SYSTEM_BACKUP_RECOVERY_GRANT_SHA256=REPLACE_WITH_REVIEWED_RECOVERY_GRANT_SHA256
SYSTEM_BACKUP_EXECUTION_PROFILE_FILE=/run/system-backup/execution-profile.json
SYSTEM_BACKUP_CAPACITY_REPORT_FILE=/run/system-backup/capacity.json
# Set true only after independent admission; both deployment and config gates apply.
SYSTEM_BACKUP_ENABLED=false
SYSTEM_BACKUP_V2_EXECUTION_ENABLED=false
# public-deployment.json uses DeploymentConfig's exact closed schema:
# forward_grant/recovery_grant: {path, public_key_base64} (public keys only)
# key_directory: /run/system-backup/record-and-staging-keys
# issuer_certificate / issuer_key / issuer_certificate_sha256
# server_certificate / server_key / source_dsn_file
# All paths refer to read-only controlled mounts, not repository files.
# Private files must be readable by the process only (Linux mode 0400/0600);
# a default world-readable Secret mount does not satisfy readPrivate.
# Formal KEK/signer/provider bindings need reviewed composition and live resolvers;
# no token, private key, DEK, or invented provider environment switch belongs here.
